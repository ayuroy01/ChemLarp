# Hydrogen / oxygen combustion, 9 species, 19 reactions.
#
# ILLUSTRATIVE PARAMETERS. Rate constants follow the structure and approximate
# values of the Li, Zhao, Kazakov & Dryer (2004) H2/O2 mechanism, with the
# pressure fall-off reactions reduced to their low-pressure third-body limits.
# Use it to exercise the solver; for quantitative work, replace it with a
# validated mechanism.
#
# Reverse rates are NOT listed: OmniChem computes them from detailed balance
# with the species thermo, so long-time results equal the Gibbs equilibrium.

species
  H2     [H][H]
  O2     O=O
  H      [H]
  O      [O]
  OH     [OH]
  H2O    O
  HO2    [O]O
  H2O2   OO
  AR     [Ar]
end

reactions  cal/mol  cm3
  # chain branching / propagation
  H + O2 <=> O + OH            3.547e15  -0.406   16599
  O + H2 <=> H + OH            5.080e4    2.67     6290
  H2 + OH <=> H2O + H          2.160e8    1.51     3430
  O + H2O <=> OH + OH          2.970e6    2.02    13400

  # dissociation / recombination
  H2 + M <=> H + H + M         4.577e19  -1.40   104380
    H2/2.5/ H2O/12.0/ AR/0.0/
  H2 + AR <=> H + H + AR       5.840e18  -1.10   104380
  O + O + M <=> O2 + M         6.165e15  -0.50        0
    H2/2.5/ H2O/12.0/ AR/0.83/
  O + H + M <=> OH + M         4.714e18  -1.00        0
    H2/2.5/ H2O/12.0/ AR/0.75/
  H + OH + M <=> H2O + M       3.800e22  -2.00        0
    H2/2.5/ H2O/12.0/ AR/0.38/

  # HO2 formation and consumption (fall-off reduced to low-pressure limit)
  H + O2 + M <=> HO2 + M       6.366e20  -1.72      525
    H2/2.0/ H2O/11.0/ O2/0.78/ AR/0.67/
  HO2 + H <=> H2 + O2          1.660e13   0.00      823
  HO2 + H <=> OH + OH          7.079e13   0.00      295
  HO2 + O <=> O2 + OH          3.250e13   0.00        0
  HO2 + OH <=> H2O + O2        2.890e13   0.00     -497

  # H2O2
  HO2 + HO2 <=> H2O2 + O2      4.200e14   0.00    11982
  H2O2 + M <=> OH + OH + M     1.200e17   0.00    45500
    H2/2.5/ H2O/12.0/ AR/0.64/
  H2O2 + H <=> H2O + OH        2.410e13   0.00     3970
  H2O2 + H <=> HO2 + H2        4.820e13   0.00     7950
  H2O2 + OH <=> H2O + HO2      1.000e12   0.00        0
end
